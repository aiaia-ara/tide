#!/bin/bash

# =============================================================================
# ------------------------------ tIDE (tmux IDE) ------------------------------
# =============================================================================
#
# tide: launch a tmux session with Neovim on the left, Claude Code on the right,
# and a shell across the bottom.
#
# Requires tmux >= 3.7b: 3.7a has a bug where content drawn inside a
# synchronized update (which Neovim uses for its frames) is not redrawn to
# the terminal, leaving the Neovim pane blank until something else forces a
# repaint. Fixed upstream in 3.7b ("Fix so that the end of a synchronized
# update again triggers a redraw").
#
# When the editor or the secondary command exits, its pane drops into the
# interactive shell instead of closing (the same behavior you'd get if you'd
# opened the pane manually and run the program yourself). Exit the shell
# (Ctrl+D or `exit`) to actually close the pane.
#
# Panes run a plain shell rather than a login shell, so the environment tide was
# launched with is inherited intact instead of being rebuilt in each pane. See
# the comment above the tmux invocation for why that matters.

# =============================================================================

# Exit on use of an unset variable, so a mistyped name fails loudly instead of
# quietly expanding to an empty string.
set -u

# Parse command line options.
usage() {
  echo "Usage: $0 [-s SESSION] [-w WINDOW] [-d DIR] [-H|-V] [-l SIZE] [-b SIZE] [-e EDITOR] [-c COMMAND] [-p VENV] [-h]"
  echo "  -s SESSION   Session name (default: tide)"
  echo "  -w WINDOW    Window name (default: main)"
  echo "  -d DIR       Start directory (default: .)"
  echo "  -H           Horizontal split, side-by-side (default)"
  echo "  -V           Vertical split, stacked"
  echo "  -l SIZE      Editor/command split size, 1-99% or absolute (default: 50%)"
  echo "  -b SIZE      Bottom console size, 1-99% or absolute (default: 15%)"
  echo "  -e EDITOR    Editor command for main pane (default: nvim)"
  echo "  -c COMMAND   Command for split pane  (default: claude)"
  echo "  -p VENV      Python virtualenv to launch every pane in"
  echo "  -h           Show this help"
  exit "${1:-1}"
}

# Defaults:
session_name="tide"
window_name="main"
start_directory="."
layout="-h"
size="50%"
console_size="15%"
editor="nvim"
side_command="claude"
venv=""

# -H and -V select the split orientation. The value they store is tmux's own
# split-window flag, where -h splits side-by-side and -v splits stacked.
while getopts ":s:w:d:HVl:b:e:c:p:h" opt; do
  case $opt in
    s) session_name="$OPTARG" ;;
    w) window_name="$OPTARG" ;;
    d) start_directory="$OPTARG" ;;
    H) layout="-h" ;;
    V) layout="-v" ;;
    l) size="$OPTARG" ;;
    b) console_size="$OPTARG" ;;
    e) editor="$OPTARG" ;;
    c) side_command="$OPTARG" ;;
    p) venv="$OPTARG" ;;
    h) usage 0 ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      usage
      ;;
    :)
      echo "Option -$OPTARG requires an argument." >&2
      usage
      ;;
  esac
done

# Validate a split size: 1-99% of the window, which has to leave room for the
# other panes, or an absolute number of rows/columns.
check_size() {
  if ! [[ $2 =~ ^([1-9][0-9]?%|[1-9][0-9]*)$ ]]; then
    echo "Error: $1 must be 1-99% or a positive number: $2" >&2
    usage
  fi
}
check_size -l "$size"
check_size -b "$console_size"

# Resolve -p against the start directory, so `-d ~/proj -p .venv` means
# ~/proj/.venv rather than something relative to wherever tide was typed, and
# check it here so a typo dies now instead of three panes later.
#
# The `cd && pwd` is not cosmetic. Left relative, `-p .venv` would put
# ./.venv/bin on PATH, and a relative PATH entry means "relative to wherever the
# process asking happens to be standing" - so it would quietly stop finding the
# venv on the first `cd`. VIRTUAL_ENV must be absolute for the same reason.
# Plain `pwd` keeps the logical path, so a venv reached through a symlink still
# reads as the path you recognize.
if [[ -n $venv ]]; then
  [[ $venv == /* ]] || venv="$start_directory/$venv"
  if [[ ! -r "$venv/bin/activate" ]]; then
    echo "Error: -p is not a virtualenv (no bin/activate): $venv" >&2
    usage
  fi
  if ! resolved=$(cd "$venv" && pwd); then
    echo "Error: -p exists but cannot be entered: $venv" >&2
    usage
  fi
  venv=$resolved
fi

# Enforce the tmux version documented at the top of this file. On 3.7a the
# editor pane just stays blank, with nothing said to explain it, so the check
# earns its keep by turning a mystery into a sentence.
#
# The comparison is against a floor rather than a fixed version, because tmux
# moves on its own schedule and every release above the floor is fine. Nothing
# here needs editing when it does.
#
# version_key rewrites a version as a fixed-width string - "3.7a" becomes
# "003007a" - so that an ordinary text comparison orders versions correctly.
# The zero-padding is the load-bearing part: without it "3.10" sorts below
# "3.7b", since a text comparison reads one character at a time and sees "1"
# before "7" rather than ten before seven.
#
# A version that does not parse - "next-3.9", "3.7b-openbsd", a distro or git
# build - is allowed through rather than blocked. tide cannot rank those, and
# refusing to start on a tmux that is very likely fine is the worse failure.
required_tmux="3.7b"

version_key() {
  [[ $1 =~ ^([0-9]+)\.([0-9]+)([a-z]?)$ ]] || return 1
  printf '%03d%03d%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

tmux_version=$(tmux -V | cut -d' ' -f2)
required_key=$(version_key "$required_tmux")
if key=$(version_key "$tmux_version") && [[ $key < $required_key ]]; then
  echo "Error: tmux $required_tmux or newer is required (found $tmux_version)." >&2
  echo "On older tmux the editor pane stays blank until something forces a repaint." >&2
  exit 1
fi

# If the session already exists, just attach.
#
# -p is the one option where that is worth saying out loud. Attaching runs none
# of the setup below, so the panes keep whatever environment they were started
# with, and asking for a virtualenv would otherwise appear to do nothing at all.
# Every other option is silently ignored here too, but none of them look broken
# when they are. The prompt is skipped when stdin is not a terminal, so tide
# still works unattended.
if tmux has-session -t "$session_name" 2>/dev/null; then
  if [[ -n $venv ]]; then
    echo "Note: session '$session_name' already exists. Attaching leaves its panes" >&2
    echo "in the environment they were started with, so -p will have no effect." >&2
    if [[ -t 0 ]]; then
      reply=""
      read -r -p "Attach anyway? [y/N] " reply
      [[ $reply == [yY]* ]] || exit 1
    fi
  fi
  tmux attach -t "$session_name"
  exit 0
fi

# Use the user's interactive shell when the program exits, so the pane
# stays open. Falls back to /bin/sh in the unlikely case $SHELL is unset.
shell="${SHELL:-/bin/sh}"

# A virtualenv has to be written into the command each pane runs, because of how
# tmux decides a pane's PATH. It takes it from the client that asked for the
# pane, but only while that client is still unattached - spawn.c reads
# `if (c != NULL && c->session == NULL)` - and otherwise from the session
# environment. tide's new-session attaches, so every command chained after it,
# which is all of them, falls into the second case.
#
# That rules out exporting the virtualenv here before `exec tmux`: it reaches
# the panes only when tide happens to fork the tmux server, and a server
# outlives any one session, so usually it does not. `new-session -e PATH=` is
# overwritten by that same block. On the later commands `-e PATH=` and
# `set-environment PATH` do work, but only because the client has attached by
# then, which is the same undocumented rule; `-e` also misses panes opened
# later, and `set-environment -g` changes every session on the server.
#
# A command string depends on none of that, since tmux runs it verbatim. Sourcing
# bin/activate would add nothing over it either: each pane ends in
# `exec "$shell"`, which keeps only exported variables.
#
# $PATH has to reach the pane unexpanded, so that it resolves there, against
# whatever tmux gave that pane - expanding it here would freeze tide's own PATH
# into every pane instead. The format string below is single-quoted precisely so
# that cannot happen: $PATH is literal by construction rather than by an escape
# somebody could drop. printf -v assigns without a subshell.
#
# The paths go in with %q, not %s. This string crosses a parsing boundary: tide
# writes it, and the pane's shell later parses it as code. %s would copy a path
# in raw, so a $ in it would be expanded away by that shell and a backtick would
# be executed - silently, since the result is a plausible-looking wrong path.
# %q escapes the value so re-parsing yields the bytes back. It is a bashism, but
# tide is already bash-only, and every form it emits here (backslash escapes,
# and $'...' for control characters) is understood by zsh.
venv_prefix=""
if [[ -n $venv ]]; then
  printf -v venv_prefix \
    'export VIRTUAL_ENV=%q VIRTUAL_ENV_PROMPT=%q; export PATH=%q:$PATH; ' \
    "$venv" "${venv##*/}" "$venv/bin"
fi

# Everything happens in one tmux invocation, in this order:
#
#   1. new-session (attached)  - the session is created at the terminal's
#      real size, since tmux gets it directly from the attaching client. Its
#      window is a throwaway, deleted in step 9.
#   2. set-option              - default-command is what tmux runs in a pane
#      started without a command. Empty, its default, means a login shell,
#      which on macOS re-runs /etc/zprofile's path_helper; that rebuilds PATH
#      with the system directories first and demotes whatever a parent put in
#      front, a virtualenv included. A plain shell keeps what it was handed,
#      makes the console match the other two panes - whose fallback shells are
#      already plain - and skips a ~17ms ~/.zprofile in every pane. It is also
#      where -p rides for the console and for any pane opened later, since
#      those are the panes tmux starts without a command of their own.
#   3. new-window -b           - the real window, placed before the throwaway
#      so it ends up with the index it would have had without one. Its first
#      pane is the console: an interactive shell in the start directory, which
#      is all a console is.
#   4. split-window -b -v -E   - an empty pane above the console, held for the
#      editor. -E starts nothing in it.
#   5. resize-pane             - the console down to its final height.
#   6. split-window            - the secondary command's pane, split off the
#      editor's with the command already in it. The layout is final from here
#      on. (-d keeps focus on the editor pane.)
#   7. send-keys -R            - resets the empty pane's terminal state.
#   8. respawn-pane            - the editor, launched into its pane.
#   9. kill-window -a          - deletes every window except the current one,
#      which leaves only the real window.
#
# set-option has to precede new-window, since the console is the pane that
# reads the option. new-session's pane starts before it is set, but that pane
# is the throwaway. -t keeps the option on this session, leaving any other tmux
# session on the server untouched.
#
# No program starts until its pane has its final size: Neovim 0.12 sizes its
# UI once at startup and can miss resizes that arrive while it is still
# initializing (vim.pack runs synchronously during startup), leaving it
# permanently rendered at the wrong size. So the console, which spans the full
# width beneath both other panes, is sized first, and step 6 is the last change
# to the layout.
#
# Nothing is killed to make room for a program, which is why the editor's pane
# starts empty instead of holding a placeholder shell. Replacing a running
# program (respawn-pane -k) closes the pane's pty and opens a new one
# microseconds apart, and macOS has a bug there: when its pty table is exactly
# full (16, 32, 48... ptys in use across the whole machine), a pty released
# while another is being opened makes that open fail with "Device not
# configured". That leaves the editor pane blank, and since a failed command
# makes tmux drop the rest of the chain, the secondary command never starts
# either. Opening a pty while none is being released works at any fill level;
# the table just grows.
#
# The throwaway window is there for PATH. tmux gives new-session's own pane the
# PATH of the terminal tide runs in, and every pane created after the client
# attaches the session environment's, which is the server's (see the -p comment
# above). The two differ whenever a server was already running and the
# terminal's PATH has changed since. Made after the attach, all three real panes
# always agree. The throwaway's pty is the only one tide closes, and it closes
# it last, with nothing opened after it.
#
# A pane created with -E is set up for no program at all, and tmux turns on a
# mode in it where a bare line feed also returns the cursor to the start of the
# line. A program respawned into the pane would inherit that mode; send-keys -R
# clears it, so the editor starts in the same terminal state as any other pane.
#
# The editor's pane is targeted as {top-left}: with three panes open, {top}
# would match whichever of the two upper panes tmux reaches first, not
# necessarily the editor. {down-of} in step 5 can only be the console, since
# just two panes exist at that point.
#
# `; exec "$shell"` drops a pane into your shell once its program exits.
exec tmux new-session -s "$session_name" -n "$window_name" -c "$start_directory" \; \
  set-option -t "$session_name" default-command "${venv_prefix}exec \"$shell\"" \; \
  new-window -b -n "$window_name" -c "$start_directory" \; \
  split-window -b -v -E \; \
  resize-pane -t '{down-of}' -y "$console_size" \; \
  split-window -d "$layout" -l "$size" -c "$start_directory" "${venv_prefix}$side_command; exec \"$shell\"" \; \
  send-keys -R -t '{top-left}' \; \
  respawn-pane -t '{top-left}' -c "$start_directory" "${venv_prefix}$editor; exec \"$shell\"" \; \
  kill-window -a
